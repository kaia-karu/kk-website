{
  "name": "@starterculture/devlore",
  "version": "0.1.7",
  "description": "Agentic knowledge base that documents code and decisions across every linked project.",
  "bin": {
    "devlore": "dist/server/index.js"
  },
  "files": [
    "dist",
    "public",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "npm run sync:assets",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "serve": "ts-node src/server/index.ts",
    "preserve": "npm run sync:assets",
    "sync:assets": "mkdir -p assets && cp docs/USER_MANUAL.md assets/user-manual.md",
    "prepublishOnly": "npm run build && cp PACKAGE_README.md README.md",
    "postpublish": "git checkout -- README.md"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@napi-rs/keyring": "^1.3.0",
    "@octokit/rest": "^20.1.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "supertest": "^7.2.2",
    "svg-pan-zoom": "^3.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0"
  }
}
